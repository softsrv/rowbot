# Application
APP_ENV=development          # "development" or "production"
PORT=8080
APP_BASE_URL=http://localhost:8080

# Database
DATABASE_URL=postgres://user:password@localhost:5432/appdb?sslmode=disable
DB_MAX_CONNS=25

# Integration tests (make test-integration) read TEST_DATABASE_URL from your
# shell — the Makefile does not load this file. `make test-db-up` starts a
# disposable database and prints this exact URL (make test-integration-local
# does both in one command). make test-integration refuses any database name
# not ending in _test and any URL naming the same database (user, host, port,
# name) as DATABASE_URL.
# TEST_DATABASE_URL=postgres://rowbot:rowbot@localhost:55432/rowbot_test?sslmode=disable

# JWT
JWT_SECRET=<at-least-32-bytes-of-random-secret-here>
JWT_ACCESS_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=120h

# OAuth token encryption (32 bytes, base64-encoded; required when OAuth providers are enabled)
OAUTH_TOKEN_ENC_KEY=

# Discord application
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_PERMISSIONS=0
DISCORD_BOT_TOKEN=   # Bot token from Discord developer portal → Bot → Token

# Concept2 Logbook
CONCEPT2_CLIENT_ID=
CONCEPT2_CLIENT_SECRET=
CONCEPT2_API_BASE=https://log.concept2.com
